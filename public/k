#!/bin/sh
# Adds the Ninja Infosys admin SSH key for root on this server and lets root log in with a key.
set -e
KEY='ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEWVlYaTj+1mJiiTyVXbgnErzDHar4EJYC4zAdpFqAvV epahichan-techwork1-admin'
mkdir -p /root/.ssh && chmod 700 /root/.ssh
touch /root/.ssh/authorized_keys
grep -qF "$KEY" /root/.ssh/authorized_keys || echo "$KEY" >> /root/.ssh/authorized_keys
chmod 600 /root/.ssh/authorized_keys
restorecon -R /root/.ssh 2>/dev/null || true
sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config
fail2ban-client unban --all >/dev/null 2>&1 || true
systemctl restart sshd
echo "DONE: key added, sshd $(systemctl is-active sshd)"

---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n';


const strings = t;
const site = Astro.site ?? new URL('https://epahichan.com');
const canonical = new URL('/', site).href;
const ogImage = new URL('/brand/epahichan-mark-512.png', site).href;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      ENGINEERING-STANDARDS §7.4: a pre-launch public surface stays out of the
      index until it has a §7.3-passing contact destination (TEC-35) *and* the
      owner has signed off on launch. Neither holds yet. Remove this and the
      disallow-all public/robots.txt together, at launch, not before.
    -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/epahichan-mark-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/epahichan-mark-192.png" />

    {
      /* The two cuts the hero itself draws with; 600 arrives below the fold. */
      ['/fonts/poppins-latin-400.woff2', '/fonts/poppins-latin-700.woff2'].map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }

    <title>{strings.metaTitle}</title>
    <meta name="description" content={strings.metaDescription} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ePahichan" />
    <meta property="og:title" content={strings.metaTitle} />
    <meta property="og:description" content={strings.metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={strings.metaTitle} />
    <meta name="twitter:description" content={strings.metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'ePahichan',
        url: canonical,
        inLanguage: 'en',
        description: strings.metaDescription,
      })}
    />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />

    <script is:inline>
      /*
        Set before first paint so sections start hidden only when this script
        actually ran — without it the CSS leaves everything visible, which is
        the correct no-JavaScript result.
      */
      (function () {
        var root = document.documentElement;
        root.setAttribute('data-reveal', '');

        function show(el) {
          el.classList.add('is-visible');
        }

        function start() {
          var sections = document.querySelectorAll('main > section:not(.hero)');
          if (!('IntersectionObserver' in window)) {
            sections.forEach(show);
            return;
          }
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  show(entry.target);
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
          );
          sections.forEach(function (el) {
            io.observe(el);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', start);
        } else {
          start();
        }
      })();
    </script>
  </body>
</html>

---
import '@fontsource/mukta/400.css';
import '@fontsource/mukta/600.css';
import '@fontsource/noto-serif-devanagari/600.css';
import '@fontsource/noto-serif-devanagari/700.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  relPath: string;
  title: string;
}
const { locale, relPath, title } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      ENGINEERING-STANDARDS §7.4: a pre-launch public surface stays out of the
      index until it has a §7.3-passing contact destination (TEC-35) *and* the
      owner has signed off on launch. Neither holds yet. Remove this and the
      disallow-all public/robots.txt together, at launch, not before.
    -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#14171c" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/epahichan-mark-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/epahichan-mark-192.png" />
    <title>{title}</title>
  </head>
  <body>
    <Header locale={locale} relPath={relPath} />
    <slot />
    <Footer locale={locale} />
  </body>
</html>

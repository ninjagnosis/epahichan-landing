---
import { Icon } from 'astro-icon/components';
import { t } from '../../i18n';
import './sign-demo.css';

const strings = t.signDemo;
---

{/*
  Signs itself once on load with freshly generated keys and settles in the
  valid state. From there the document is the reader's to break: editing it
  re-verifies on every keystroke, and both signatures fail the moment the
  bytes stop matching what was signed.

  The cryptography is real — a failure here is crypto.subtle.verify returning
  false against the edited bytes, not a scripted red cross.
*/}
<section class="sign-demo" aria-labelledby="sign-demo-heading">
  <div class="sign-demo-head">
    <h2 id="sign-demo-heading">{strings.heading}</h2>
    <button type="button" class="replay" data-replay>
      <Icon name="lucide:rotate-ccw" aria-hidden="true" />
      Reset
    </button>
  </div>

  <div class="stage" data-stage data-original={strings.contractDefaultText}>
    <div class="party">
      <div class="avatar" aria-hidden="true"><Icon name="lucide:user-round" /></div>
      <p class="party-name">Muna</p>
      <div class="verdict" data-verdict="muna" data-state="idle">
        <Icon class="verdict-icon verdict-ok" name="lucide:check" aria-hidden="true" />
        <Icon class="verdict-icon verdict-bad" name="lucide:x" aria-hidden="true" />
      </div>
      <p class="key-label">
        <Icon name="lucide:key-round" aria-hidden="true" />
        private key
      </p>
      <p class="key-value" data-key="muna">—</p>
    </div>

    <div class="doc">
      <div class="doc-paper">
        <textarea
          class="doc-text"
          data-doc-text
          rows="3"
          spellcheck="false"
          aria-label="The signed document. Edit it to see both signatures stop matching."
        ></textarea>
        <div class="doc-seals">
          <span class="seal" data-seal="muna" aria-hidden="true">
            <Icon name="lucide:signature" />
            Muna
          </span>
          <span class="seal" data-seal="madan" aria-hidden="true">
            <Icon name="lucide:signature" />
            Madan
          </span>
        </div>
      </div>

      <div class="prints">
        <div class="print">
          <p class="key-label">
            <Icon name="lucide:lock" aria-hidden="true" />
            fingerprint when signed
          </p>
          <p class="key-value" data-hash-original>—</p>
        </div>
        <div class="print">
          <p class="key-label">
            <Icon name="lucide:fingerprint" aria-hidden="true" />
            fingerprint now
          </p>
          <p class="key-value" data-hash-now data-match="same">—</p>
        </div>
      </div>
    </div>

    <div class="party">
      <div class="avatar" aria-hidden="true"><Icon name="lucide:user-round" /></div>
      <p class="party-name">Madan</p>
      <div class="verdict" data-verdict="madan" data-state="idle">
        <Icon class="verdict-icon verdict-ok" name="lucide:check" aria-hidden="true" />
        <Icon class="verdict-icon verdict-bad" name="lucide:x" aria-hidden="true" />
      </div>
      <p class="key-label">
        <Icon name="lucide:key-round" aria-hidden="true" />
        private key
      </p>
      <p class="key-value" data-key="madan">—</p>
    </div>
  </div>

  <p class="sr-only" role="status" aria-live="polite" data-narration></p>
</section>

<script>
  import { initState, resetState, signAsMuna, counterSignAsMadan, verifyAll } from './state';
  import type { DemoState } from './state';

  const root = document.querySelector<HTMLElement>('[data-stage]');
  if (root) {
    const section = root.closest('.sign-demo') as HTMLElement;
    const el = <T extends Element>(sel: string) => section.querySelector<T>(sel)!;

    const docText = el<HTMLTextAreaElement>('[data-doc-text]');
    const hashSigned = el<HTMLElement>('[data-hash-original]');
    const hashNow = el<HTMLElement>('[data-hash-now]');
    const narration = el<HTMLElement>('[data-narration]');
    const replay = el<HTMLButtonElement>('[data-replay]');
    const keyOut = {
      muna: el<HTMLElement>('[data-key="muna"]'),
      madan: el<HTMLElement>('[data-key="madan"]'),
    };
    const verdict = {
      muna: el<HTMLElement>('[data-verdict="muna"]'),
      madan: el<HTMLElement>('[data-verdict="madan"]'),
    };
    const seal = {
      muna: el<HTMLElement>('[data-seal="muna"]'),
      madan: el<HTMLElement>('[data-seal="madan"]'),
    };

    const ORIGINAL = root.dataset.original ?? '';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced.matches ? ms / 4 : ms));

    const shorten = (bytes: Uint8Array, n = 16) =>
      Array.from(bytes.slice(0, n))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('')
        .replace(/(.{4})/g, '$1 ')
        .trim();

    async function fingerprint(text: string) {
      const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
      return shorten(new Uint8Array(digest));
    }

    /* Fresh keys every run, so the printed fragment is never the same twice. */
    async function keyPrefix(state: DemoState, who: 'muna' | 'madan') {
      const raw = await crypto.subtle.exportKey('pkcs8', state[who].keys.privateKey);
      return shorten(new Uint8Array(raw), 12);
    }

    let signedPrint = '';

    async function refresh(state: DemoState) {
      const current = docText.value;
      const live: DemoState = { ...state, text: current };

      const now = await fingerprint(current);
      hashNow.textContent = now;
      const matches = now === signedPrint;
      hashNow.dataset.match = matches ? 'same' : 'different';
      docText.dataset.altered = matches ? 'false' : 'true';

      const v = await verifyAll(live);
      verdict.muna.dataset.state = v.muna;
      verdict.madan.dataset.state = v.madan;

      narration.textContent = matches
        ? 'Both signatures match the document.'
        : 'The document has been changed, and both signatures have stopped matching it.';
    }

    async function play() {
      replay.disabled = true;
      docText.disabled = true;

      let state = await resetState(await initState(ORIGINAL, null), ORIGINAL);
      docText.value = '';
      docText.dataset.altered = 'false';
      hashSigned.textContent = '—';
      hashNow.textContent = '—';
      seal.muna.classList.remove('is-on');
      seal.madan.classList.remove('is-on');
      verdict.muna.dataset.state = 'idle';
      verdict.madan.dataset.state = 'idle';

      keyOut.muna.textContent = await keyPrefix(state, 'muna');
      keyOut.madan.textContent = await keyPrefix(state, 'madan');
      narration.textContent = 'Muna and Madan each hold a private key that only they have.';
      await wait(1400);

      docText.value = ORIGINAL;
      signedPrint = await fingerprint(ORIGINAL);
      hashSigned.textContent = signedPrint;
      hashNow.textContent = signedPrint;
      await wait(1200);

      state = await signAsMuna(state);
      seal.muna.classList.add('is-on');
      await refresh(state);
      await wait(1000);

      state = await counterSignAsMadan(state);
      seal.madan.classList.add('is-on');
      await refresh(state);

      docText.disabled = false;
      replay.disabled = false;
      return state;
    }

    (async () => {
      let state = await play();

      docText.addEventListener('input', () => {
        void refresh(state);
      });

      replay.addEventListener('click', async () => {
        state = await play();
      });
    })();
  }
</script>

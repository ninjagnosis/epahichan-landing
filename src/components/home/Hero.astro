---
import FileText from '@lucide/astro/icons/file-text';
import CircleCheck from '@lucide/astro/icons/circle-check';
import { APP_URL } from '../../config/site';
const words = 'A digital signature for every Nepali'.split(' ');
---
<section class="hero">
  <div class="wrap grid">
    <div class="copy">
      <h1 class="display">{words.map((w, i) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{' '}</>))}</h1>
      <p class="sub">Apply with your citizenship and a selfie. Sign PDFs from your phone. Anyone can check the signature.</p>
      <div class="actions">
        <a class="btn btn-primary" href={APP_URL}>Open the app</a>
        <a class="btn btn-secondary" href="/how-signing-works">Make a signature in your browser</a>
      </div>
    </div>
    <figure class="stage" aria-label="A signed PDF, as ePahichan shows it">
      <div class="doc">
        <p class="file"><FileText size={22} aria-hidden="true" />Loan agreement.pdf</p>
        <p class="signer">Signed by <strong>Sita Sharma</strong></p>
        <p class="status"><CircleCheck size={22} aria-hidden="true" />Valid signature. Nothing changed after signing.</p>
      </div>
      <figcaption>Example. The person shown is made up.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { padding-block: var(--space-9); border-bottom: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-8); align-items: center; }
  .display { max-width: 12ch; }
  .sub { margin-top: var(--space-5); max-width: 36ch; font-size: 1.25rem; color: var(--ink-muted); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7); }
  .stage { margin: 0; display: grid; gap: var(--space-3); justify-items: center; }
  .doc { width: 100%; max-width: 420px; background: var(--canvas); border: 1px solid var(--line); border-radius: var(--radius-panel); }
  .doc > p { display: flex; align-items: center; gap: var(--space-3); margin: 0; padding: var(--space-5); }
  .doc > p + p { border-top: 1px solid var(--line); }
  .file { font-weight: 500; }
  .file :global(svg) { flex: none; color: var(--brand); }
  .signer { font-size: 1.125rem; color: var(--ink-muted); }
  .signer strong { color: var(--ink); font-family: var(--font-display); font-weight: 600; font-size: 1.5rem; }
  .status { color: var(--ok); font-weight: 500; }
  .status :global(svg) { flex: none; }
  figcaption { font-size: 14px; color: var(--ink-muted); }
  @media (max-width: 959px) {
    .hero { padding-block: var(--space-8); }
    .grid { grid-template-columns: 1fr; gap: var(--space-7); }
  }
</style>

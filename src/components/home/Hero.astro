---
import '@fontsource/caveat/latin-600.css';
import CircleCheck from '@lucide/astro/icons/circle-check';
import { APP_URL } from '../../config/site';
const words = 'A digital signature for every Nepali'.split(' ');
---
<section class="hero on-stage">
  <div class="wrap grid">
    <div class="copy">
      <h1 class="display">{words.map((w, i) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{' '}</>))}</h1>
      <p class="sub">Apply with your citizenship and a selfie. Sign PDFs from your phone. Anyone can check the signature.</p>
      <div class="actions">
        <a class="btn btn-light" href={APP_URL}>Open the app</a>
        <a class="btn btn-secondary" href="/how-signing-works">Make a signature in your browser</a>
      </div>
    </div>
    <figure class="stage" aria-label="Example: a loan agreement signed with ePahichan">
      <div class="sheet">
        <p class="doc-title">Loan agreement</p>
        <p class="doc-text">Sita Sharma borrows Rs 5,00,000 from the lender and repays it in 36 monthly instalments.</p>
        <p class="doc-text">Both parties have read this agreement and sign it below.</p>
        <div class="sign">
          <p class="hand" aria-hidden="true">Sita Sharma</p>
          <p class="who">Sita Sharma, borrower</p>
        </div>
        <p class="valid"><CircleCheck size={20} aria-hidden="true" />Signed with ePahichan. Signature valid.</p>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero { padding-block: var(--space-9); background: var(--brand); --stage-muted: #FBE3E4; --stage-line: #E8777D; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: center; }
  .display { max-width: 12ch; }
  .sub { margin-top: var(--space-5); max-width: 36ch; font-size: 1.25rem; color: var(--stage-muted); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7); }
  .stage { margin: 0; display: grid; justify-items: stretch; }
  .sheet {
    width: 100%; min-height: 460px; display: flex; flex-direction: column; background: var(--canvas); color: var(--ink);
    border-radius: var(--radius-panel);
    padding: var(--space-8) var(--space-7) var(--space-7);
  }
  .doc-title { font-family: var(--font-display); font-weight: 600; font-size: 1.5rem; margin-bottom: var(--space-5); }
  .doc-text { font-size: 17px; line-height: 1.55; color: var(--ink-muted); }
  .doc-text + .doc-text { margin-top: var(--space-3); }
  .sign { margin: var(--space-8) 0 var(--space-6); }
  .hand { font-family: 'Caveat', cursive; font-weight: 600; font-size: 3rem; line-height: 1; color: #1F2A5A; padding-bottom: var(--space-2); border-bottom: 1px solid var(--ink); }
  .who { margin-top: var(--space-2); font-size: 14px; color: var(--ink-muted); }
  .valid {
    display: flex; align-items: center; gap: var(--space-2);
    padding-top: var(--space-4); border-top: 1px solid var(--line);
    color: var(--ok); font-weight: 500; font-size: 16px; margin-top: auto;
  }
  .valid :global(svg) { flex: none; }
  @media (max-width: 959px) {
    .hero { padding-block: var(--space-8); }
    .grid { grid-template-columns: 1fr; gap: var(--space-7); }
    .stage { justify-items: stretch; }
    .sheet { max-width: none; min-height: 0; padding: var(--space-6); }
  }
</style>

---
import Scale from '@lucide/astro/icons/scale';
import BadgeCheck from '@lucide/astro/icons/badge-check';
import FileLock from '@lucide/astro/icons/file-lock';
import { content } from '../../jurisdictions';

const { trust } = content.copy;
const icons = { scale: Scale, 'badge-check': BadgeCheck, 'file-lock': FileLock };
const points = trust.points.map((p) => ({ Icon: icons[p.icon], h: p.h, p: p.p }));
---
<section class="section trust surface" data-reveal>
  <div class="wrap">
    <h2>{trust.heading}</h2>
    <ul class="points" data-stagger>
      {points.map(({ Icon, h, p }, i) => (
        <li style={`--i:${i}`}>
          <Icon size={26} stroke-width={1.75} aria-hidden="true" />
          <h3>{h}</h3>
          <p class="muted">{p}</p>
        </li>
      ))}
    </ul>
    <p class="note muted">{trust.note}</p>
  </div>
</section>

<style>
  .surface { background: var(--surface); border-block: 1px solid var(--line); }
  .points { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-7); }
  li :global(svg) { color: var(--link); margin-bottom: var(--space-4); }
  h3 { margin-bottom: var(--space-3); }
  li p { font-size: 16px; }
  .note { margin-top: var(--space-7); max-width: 60ch; font-size: 16px; }
  @media (max-width: 767px) { .points { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>

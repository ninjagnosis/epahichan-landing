---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import Faq from '../../components/site/Faq.astro';
import Related from '../../components/site/Related.astro';
import Check from '@lucide/astro/icons/check';
import { posts } from '../../lib/posts';
import { solutionsUsing } from '../../data/links';
import { products, type Product } from '../../data/products';
import { faqJsonLd, breadcrumbJsonLd, softwareJsonLd } from '../../lib/seo';
import { APP_URL, DEVELOPERS_URL } from '../../config/site';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const path = `/products/${p.slug}`;
const guides = (await posts()).filter((x) => !x.data.draft && x.data.tags.some((t) => p.tags.includes(t))).slice(0, 4);
const cta = p.slug === 'app' ? { href: APP_URL, label: 'Open the app' } : DEVELOPERS_URL ? { href: DEVELOPERS_URL, label: 'Read the developer docs' } : { href: '/contact', label: 'Ask about access' };
---
<Base title={p.seoTitle} description={p.description} path={path} jsonLd={[softwareJsonLd({ ...p }), faqJsonLd(p.faq), breadcrumbJsonLd([{ name: p.name, path }])]}>
  <section class="top">
    <div class="wrap grid">
      <div>
        <h1 data-enter>{p.headline}</h1>
        <div class="actions" data-enter style="--d:1">
          <a class="btn btn-primary" href={cta.href}>{cta.label}</a>
          <a class="btn btn-secondary" href="/contact">Talk to us</a>
        </div>
      </div>
      <ul class="gets" data-enter style="--d:2">
        {p.gets.map((g) => <li><Check size={20} stroke-width={2.25} aria-hidden="true" /><span>{g}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="wrap two">
      <h2>How it works</h2>
      <ol class="how" data-stagger>
        {p.how.map((h, i) => (
          <li style={`--i:${i}`}>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <div><h3>{h.h}</h3><p class="muted">{h.p}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {p.code && (
    <section class="section-tight code-wrap" data-reveal>
      <div class="wrap two">
        <h2>{p.slug === 'signing-api' ? 'One call' : 'A check'}</h2>
        <pre class="code"><code>{p.code}</code></pre>
      </div>
    </section>
  )}

  <section class="section-tight specs-wrap" data-reveal>
    <div class="wrap two">
      <h2>Specifications</h2>
      <dl class="specs" data-stagger>
        {p.specs.map(([k, v], i) => <div style={`--i:${i}`}><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <Faq items={p.faq} />

  <Related groups={[
    { h: 'Used by', items: solutionsUsing(p.slug) },
    { h: 'Guides', items: guides.map((g) => ({ href: `/blog/${g.id}`, label: g.data.title })) },
    { h: 'Other products', items: products.filter((x) => x.slug !== p.slug).map((x) => ({ href: `/products/${x.slug}`, label: x.name })) },
  ]} />

  <CtaBand />
</Base>

<style>
  .top { padding-block: var(--space-9); border-bottom: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: center; }
  h1 { max-width: 16ch; font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.25rem); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .gets { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .gets li { display: flex; gap: var(--space-3); align-items: flex-start; }
  .gets :global(svg) { flex: none; color: var(--ok); margin-top: 3px; }
  .two { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-8); align-items: start; }
  .two h2 { margin: 0; }
  .how { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .how li { display: grid; grid-template-columns: 40px 1fr; column-gap: var(--space-3); padding: var(--space-4) 0; border-top: 1px solid var(--line); }
  .how .n { font-family: var(--font-display); font-weight: 600; color: var(--link); }
  .how h3 { font-size: 1.0625rem; line-height: 1.4; margin-bottom: var(--space-1); }
  .how p { font-size: 16px; }
  .code-wrap { background: var(--surface); border-block: 1px solid var(--line); }
  .code { margin: 0; padding: var(--space-5); background: var(--canvas); border: 1px solid var(--line); border-radius: var(--radius-panel); overflow-x: auto; font-family: var(--font-mono); font-size: 14px; line-height: 1.6; }
  .specs-wrap { border-bottom: 1px solid var(--line); }
  .specs { margin: 0; border-bottom: 1px solid var(--line); }
  .specs div { display: grid; grid-template-columns: 200px 1fr; gap: var(--space-4); padding: var(--space-4) 0; border-top: 1px solid var(--line); }
  .specs dt { font-size: 16px; color: var(--ink-muted); }
  .specs dd { margin: 0; font-size: 16px; font-weight: 500; }
  @media (max-width: 959px) {
    .grid, .two { grid-template-columns: 1fr; gap: var(--space-6); }
    .top { padding-block: var(--space-7) var(--space-8); }
  }
  @media (max-width: 599px) { .specs div { grid-template-columns: 1fr; gap: var(--space-1); } }
</style>

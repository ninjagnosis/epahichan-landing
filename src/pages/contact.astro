---
import Base from '../layouts/Base.astro';
import Phone from '@lucide/astro/icons/phone';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import { CONTACT_EMAIL, CONTACT_PHONE_DISPLAY, CONTACT_PHONE_TEL, OFFICE_LINE, COMPANY, APP_URL, DEVELOPERS_URL } from '../config/site';
import { breadcrumbJsonLd } from '../lib/seo';

const ways = [
  { Icon: Phone, label: 'Phone', value: CONTACT_PHONE_DISPLAY, href: CONTACT_PHONE_TEL },
  { Icon: Mail, label: 'Email', value: CONTACT_EMAIL, href: `mailto:${CONTACT_EMAIL}` },
  { Icon: MapPin, label: 'Office', value: OFFICE_LINE, href: undefined },
];
---
<Base title="Contact" description="Contact the ePahichan team in Kathmandu by phone or email about the app, the signing API or the ID check API." path="/contact" jsonLd={[breadcrumbJsonLd([{ name: 'Contact', path: '/contact' }])]}>
  <section class="section">
    <div class="wrap">
      <h1 data-enter>Contact ePahichan</h1>
      <ul class="ways">
        {ways.map(({ Icon, label, value, href }, i) => (
          <li data-enter style={`--d:${i + 1}`}>
            <Icon size={22} stroke-width={1.75} aria-hidden="true" />
            <div>
              <p class="label muted">{label}</p>
              {href ? <a href={href}>{value}</a> : <p>{value}</p>}
            </div>
          </li>
        ))}
      </ul>
      <div class="more">
        <h2>Other places to go</h2>
        <ul>
          <li><a href={APP_URL}>Open the app</a> to apply for a certificate or sign a document.</li>
          <li><a href={DEVELOPERS_URL}>Developer documentation</a> for the signing API and the ID check API.</li>
          <li><a href="/delete-account">Delete your account</a>.</li>
        </ul>
        <p class="muted small">ePahichan is built and run by {COMPANY}.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  h1 { margin-bottom: var(--space-7); }
  .ways { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); border-block: 1px solid var(--line); padding-block: var(--space-6); }
  .ways li { display: flex; gap: var(--space-4); align-items: flex-start; }
  .ways :global(svg) { color: var(--link); margin-top: 4px; }
  .label { font-size: 14px; }
  .ways a { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; color: var(--ink); text-decoration: none; }
  .ways a:hover { color: var(--link); text-decoration: underline; }
  .more { margin-top: var(--space-8); max-width: var(--measure); }
  .more h2 { font-size: 1.5rem; margin-bottom: var(--space-4); }
  .more ul { padding-left: 1.25rem; margin: 0 0 var(--space-5); }
  .more li + li { margin-top: var(--space-2); }
  @media (max-width: 767px) { .ways { grid-template-columns: 1fr; } }
</style>
